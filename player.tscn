[sub_resource type="GDScript" id="GDScript_onrkg"]
script/source = "
extends CharacterBody2D

const SPEED = 300.0

func _physics_process(delta):
	var direction = 0

	if Input.is_key_pressed(KEY_A):
		direction -= 1

	if Input.is_key_pressed(KEY_D):
		direction += 1

	velocity.x = direction * SPEED
	velocity.y = 0

	move_and_slide()

	print(direction)
"

